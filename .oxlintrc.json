{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "vitest"],
	"categories": {
		"correctness": "error"
	},
	"ignorePatterns": [
		"dist/",
		"docs/.vitepress/cache/",
		"docs/.vitepress/dist/",
		"src/generated/",
		"**/__snapshots__/",
		"spec/"
	]
}
