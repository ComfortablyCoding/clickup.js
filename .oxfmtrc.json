{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"tabWidth": 2,
	"semi": true,
	"singleQuote": false,
	"useTabs": true,
	"printWidth": 120,
	"ignorePatterns": [
		"dist/",
		"docs/.vitepress/cache/",
		"docs/.vitepress/dist/",
		"src/generated/",
		"**/__snapshots__/",
		"spec/",
		"pnpm-lock.yaml"
	]
}
