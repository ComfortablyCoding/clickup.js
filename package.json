{
	"$schema": "https://json.schemastore.org/package",
	"name": "clickup.js",
	"version": "5.0.0",
	"description": "A typed ClickUp API client for any JavaScript runtime",
	"keywords": [
		"api-client",
		"clickup",
		"clickup-api",
		"sdk",
		"typescript"
	],
	"homepage": "https://comfortablycoding.github.io/clickup.js/",
	"bugs": {
		"url": "https://github.com/ComfortablyCoding/clickup.js/issues"
	},
	"license": "MIT",
	"author": "@ComfortablyCoding",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ComfortablyCoding/clickup.js.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./webhooks": "./dist/webhooks.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"codegen": "node scripts/generate.ts",
		"build": "pnpm codegen && tsdown",
		"test": "pnpm codegen && vitest",
		"typecheck": "pnpm codegen && tsc && tsc -p scripts",
		"lint": "oxlint --fix",
		"lint:check": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"spec:check": "validate-api spec/openapi.yaml",
		"docs:dev": "pnpm codegen && typedoc && vitepress dev docs",
		"docs:build": "pnpm codegen && typedoc && vitepress build docs"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.99.0",
		"@seriousme/openapi-schema-validator": "2.11.0",
		"@types/node": "26.6.6",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"tsdown": "0.23.4",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.14.1",
		"typescript": "6.0.3",
		"vitepress": "2.0.0-alpha.20",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.16.1"
}
